APP_ENV=dev
HTTP_ADDR=:8080
# docker-compose overrides DATABASE_URL / REDIS_URL / CONTENT_DIR inside containers.
DATABASE_URL=postgres://tiendao:tiendao@localhost:5432/tiendao?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CONTENT_DIR=../../content/catalog
STORY_DIR=../../content/story
WS_MAX_CLIENTS=10000

# Web origin the player sees. Google redirect URI = PUBLIC_BASE_URL + /api/v1/auth/google/callback
#   make web (Vite)  → http://localhost:5173
#   make up (Nginx)  → http://localhost:8000
PUBLIC_BASE_URL=http://localhost:5173

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ≥ 32 random bytes, e.g. `openssl rand -base64 48`. Empty in dev = random per process (sessions reset on restart).
JWT_SECRET=

# DEV ONLY — trusts the X-Dev-User-Id header (and X-Dev-Role: admin). Refused unless APP_ENV=dev.
AUTH_DEV_HEADER=true
