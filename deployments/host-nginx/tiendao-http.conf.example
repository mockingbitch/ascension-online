# Host Nginx (on the server, OUTSIDE Docker) → the Tiên Đạo container stack, PLAIN HTTP (no TLS on this server).
#
#   Internet ─▶ (Cloudflare "Flexible" SSL, optional) ─▶ THIS nginx :80 ─▶ 127.0.0.1:2000 (container nginx) ─▶ web / api
#
# Use for: a staging/internal box, or Cloudflare in "Flexible" mode (browser ↔ Cloudflare is HTTPS, Cloudflare ↔ this
# server is HTTP). For a public server prefer tiendao.conf.example (TLS here, Cloudflare "Full (strict)").
#
# Install:
#   sudo cp deployments/host-nginx/tiendao-http.conf.example /etc/nginx/sites-available/tiendao.conf
#   # edit server_name; pick variant A (behind Cloudflare) or B (DNS straight to this server)
#   sudo ln -s /etc/nginx/sites-available/tiendao.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Container side (deployments/README.md → "Trỏ domain về container"):
#   - .env: STACK_BASE_URL=http://test-site-xyz.online     (variant B; use https://… when browsers reach it via Cloudflare)
#           HTTP_BIND=127.0.0.1
#   - deployments/upstream-proxies.conf: uncomment the Docker-bridge line (real client IP).
#   - Google Cloud Console: authorized redirect URI = <STACK_BASE_URL>/api/v1/auth/google/callback.
#     Google only accepts http:// redirect URIs for localhost — on a real domain the browser-facing URL must be https
#     (i.e. variant A with Cloudflare, or the TLS config).
#   - Session cookies are `Secure` outside APP_ENV=dev: over plain HTTP end to end the browser drops them and sign-in
#     fails. Plain HTTP end to end is therefore only for the dev stack (APP_ENV=dev), e.g. an internal test box.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# What the browser actually used: Cloudflare sends X-Forwarded-Proto=https in Flexible mode; otherwise it's this hop.
map $http_x_forwarded_proto $tiendao_proto { default $scheme; https https; }

upstream tiendao {
    server 127.0.0.1:2000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name test-site-xyz.online;

    # ── Real client IP ──
    # Variant A (Cloudflare proxied): trust CF-Connecting-IP ONLY from Cloudflare ranges, and firewall :80 to Cloudflare.
    #   include /opt/tiendao/deployments/cloudflare-ips.conf;
    #   real_ip_header CF-Connecting-IP;
    #   real_ip_recursive on;
    # Variant B (DNS straight here): $remote_addr already is the client; nothing to add.

    client_max_body_size 1m;          # the container nginx enforces the same limit

    # Never expose metrics (they are internal ports anyway; belt and braces).
    location = /metrics { return 404; }

    # WebSocket (announcements, chat, Tử Tiêu Cung hall events).
    location /ws {
        proxy_pass http://tiendao;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $remote_addr;   # overwrite: the container nginx reads the client from here
        proxy_set_header X-Forwarded-Proto $tiendao_proto;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location / {
        proxy_pass http://tiendao;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $remote_addr;   # overwrite any client-supplied value
        proxy_set_header X-Forwarded-Proto $tiendao_proto;
        # SvelteKit sends large `Link` preload headers (see deployments/nginx.conf).
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
        proxy_read_timeout 30s;
    }
}
