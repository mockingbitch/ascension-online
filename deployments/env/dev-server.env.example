# Tiên Đạo — DEV SERVER (test-site-xyz.online) environment.
# Copy to the repo root on the server as `.env` (docker compose reads it via `--env-file .env`), then fill every
# <…> placeholder. NEVER commit the filled file. Generate secrets ON THE SERVER, e.g.:
#   openssl rand -base64 48 | tr -d '\n'          # JWT_SECRET, salts, sandbox secret (≥ 32 bytes)
#
# This is still the dev stack (APP_ENV=dev in docker-compose.yml: sandbox payments, dev salts allowed). Because the
# server is reachable from the Internet, the impersonation header is turned OFF below.

# ── Public URL & proxy (host nginx: deployments/host-nginx/test-site-xyz.online.conf or tiendao.conf.example) ──
# https:// when browsers come through Cloudflare (Flexible/Full) or the TLS config; http:// only without Google login.
STACK_BASE_URL=https://test-site-xyz.online
HTTP_BIND=127.0.0.1                     # container port 2000 only reachable from the host nginx
TRUSTED_PROXY_CIDRS=172.16.0.0/12       # API trusts X-Forwarded-For only from the compose network (container nginx)
# Also uncomment the `set_real_ip_from` lines in deployments/upstream-proxies.conf (real client IP).

# ── Security ──
AUTH_DEV_HEADER=false                   # MUST be false on a public server (X-Dev-User-Id = log in as anyone)
JWT_SECRET=<openssl rand -base64 48>
NETSIG_SALTS=s1:<openssl rand -base64 48>          # id:secret[,id:secret] — first is current; keep old ones when rotating
PAYMENT_SANDBOX_SECRET=<openssl rand -base64 48>   # sandbox top-up webhooks (dev-only gateway; never in prod)

# ── Google sign-in (Google Cloud Console → OAuth client, Web application) ──
# Authorized redirect URI: https://test-site-xyz.online/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# ── Monitoring (optional: make monitoring-up; Grafana/Prometheus bind to 127.0.0.1, use an SSH tunnel) ──
GRAFANA_ADMIN_PASSWORD=<strong password>

# ── Only for running Go/Vite on the host (make api / make worker / make web), not used by docker compose ──
# DATABASE_URL=postgres://tiendao:tiendao@localhost:2432/tiendao?sslmode=disable
# REDIS_URL=redis://localhost:2379/0
# PUBLIC_BASE_URL=http://localhost:5173
